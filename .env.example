# Copy this file to `.env` and fill in. `.env` is git-ignored and stays local.
# Do NOT let this file sync to OneDrive.

# --- Eight Sleep (direct) ---
EIGHTSLEEP_EMAIL=
EIGHTSLEEP_PASSWORD=
EIGHTSLEEP_TZ=Europe/London

# --- Intervals.icu (covers Garmin wellness + activities AND FORM swims) ---
# Free personal API key: intervals.icu -> Settings -> Developer Settings (bottom of page).
# Athlete id "0" resolves to whoever owns the key, so the default is usually fine.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=0

# --- Dashboard encryption ---
# Passphrase used to AES-256 encrypt the published dashboard. Choose something you'll
# remember; you type it on your phone to unlock the app. It is NEVER committed to the
# repo (only the ciphertext is). If blank, the dashboard is written in plaintext
# (local preview only -- do not publish plaintext to GitHub).
DASHBOARD_PASSPHRASE=

# --- Garmin direct (OPTIONAL) ---
# Only needed if you later want Garmin's OWN Body Battery / Training Readiness for
# comparison. Not required: Garmin activity + wellness data comes via Intervals.icu.
# GARMIN_EMAIL=
# GARMIN_PASSWORD=
